studio/npm run dev/
.vercel
# Ignore every .env* variant by default (.env, .env.local, .env.preview,
# .env.preview-ivr, .env.production, .env.vercel-preview-pulled, etc.)
# and explicitly un-ignore template files that should be in the repo.
# Catches future env variants without needing to maintain an allowlist.
.env*
!.env.example
.claude/launch.json
ivr_descriptors.csv
scripts/.bg-removal-checkpoint.json
# v2 redesign handoff — reference assets, too large to commit
/redesign/

# Content-generation cache (local artifacts only)
.cache/
.worktrees

# Discovery tagging pipeline artifacts (regenerable; large; local-only)
audience-proposal-briefs*.json
audience-proposals*.json
audience-proposals-final.csv
audience-distribution-audit.json
matters-proposal-briefs*.json
matters-proposal-proposals*.json
matters-proposal-proposals.chunk-*.raw.txt
matters-proposals*.json
matters-proposals-final.csv
matters-distribution-audit.json
mood-proposal-briefs*.json
mood-proposals*.json
mood-proposals*.csv
mood-distribution-audit.json
scripts/output/
# Compiled tsc strays next to server/*.ts sources. If these exist on disk,
# tsx/esbuild/vitest resolve './webhooks.js' to the stale artifact instead of
# the .ts source (the real Vercel entry is server/vercel-entry.mjs).
server/index.js
server/webhooks.js
server/*.js.map

# Stray subagent helper artifacts that occasionally drop here
classify-chunk-*.cjs
dispatch-all.log
apply-shadow.log

# Notebook art candidates generated by scripts/notebook-launch.sh (review locally, upload keepers, never commit)
.notebook-art/

# Scratch dirs the media-manager agent writes one-off fetch/generate helpers into
# during a hero-image run. Working files only; the keeper is the uploaded asset.
# The glob covers the name drifting between runs (content run 649 landed on
# scripts/_tmp-scratch/, which scripts/.tmp-media/ alone did not match).
scripts/.tmp-media/
scripts/_tmp-*/

# Playwright visual harness artifacts (tests/visual/__screenshots__ baselines ARE committed)
test-results/
playwright-report/
.design-snapshots/

# Local voice audition reels (throwaway TTS artifacts, never committed)
.voice-auditions/
