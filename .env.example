# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Google Cloud / Vertex AI (Imagen) ───────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── fal.ai (BiRefNet background removal — scripts/remove-product-bg.ts) ─────
FAL_KEY=                             # API key from fal.ai/dashboard/keys

# ─── Klaviyo ──────────────────────────────────────────────────────────────────
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID_DAILY_DEAL=
KLAVIYO_LIST_ID_WAITLIST=
KLAVIYO_SMS_LIST_ID=                 # SMS marketing list — used by sms-v2/klaviyo.server.ts on AGE_CONFIRM

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=                        # Neon Postgres connection string

# ─── Vercel KV ────────────────────────────────────────────────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=                      # Legacy — will be removed after Neon Auth migration
SESSION_SECRET=                      # 32+ char random string for cookie signing

# ─── Neon Auth ────────────────────────────────────────────────────────────────
NEON_AUTH_BASE_URL=                  # From Neon Console → Branch → Auth → Configuration

# ─── Security ─────────────────────────────────────────────────────────────────
CRON_SECRET=                         # Shared secret for cron endpoint protection

# ─── Feature Flags ────────────────────────────────────────────────────────────
AGE_GATE_LEVEL=click_through         # click_through | dob_entry | id_verify

# ─── ToS ──────────────────────────────────────────────────────────────────────
CURRENT_TOS_VERSION=1.0

# ─── Payment Processor (add when approved) ───────────────────────────────────
SEGPAY_MERCHANT_ID=
SEGPAY_API_KEY=

# ─── Analytics ────────────────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=                    # GTM-XXXXXXX (optional; leave blank to disable GTM)

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                          # Sentry project DSN (exposed to client via window.ENV)

# ─── Feed ─────────────────────────────────────────────────────────────────────
NALPAC_FEED_URL=https://productfeeds.wyomind.com/feeds/1s6o37vbh23/nal-top-100.csv

# ─── Twilio / Conversational IVR ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                  # AC… from Twilio console
TWILIO_AUTH_TOKEN=                   # Used for signature verification + REST API
TWILIO_PHONE_NUMBER=                 # E.164 number callers dial, e.g. +15555551234
IVR_WS_URL=                          # wss://ivr.xdipx.com/relay — Fly.io ConversationRelay WS endpoint
IVR_WS_SECRET=                       # Shared secret appended as ?token= to IVR_WS_URL; Fly rejects WS upgrades without it
IVR_MAX_CALLS_PER_HOUR=5             # Per-caller rate limit before TwiML <Reject>
IVR_BUSINESS_HOURS=                  # e.g., "9-21" = 9am-9pm local. Empty = always live. Overnight ok ("20-6").
IVR_BUSINESS_TZ=America/Chicago      # IANA tz for business-hours check
SMS_MAX_PER_HOUR=15                  # Per-number inbound SMS rate limit (silent drop above)
ELEVENLABS_API_KEY=                  # Shared with studio TTS
ELEVENLABS_VOICE_ID_IVR=             # ElevenLabs voice ID used for phone calls
INTERNAL_API_SECRET=                 # Shared secret for Fly ⇄ Vercel internal routes
APP_URL=                             # Public origin (e.g. https://xdipx.com) — used to build Twilio recording status callback URLs

# ─── Returns ──────────────────────────────────────────────────────────────────
# Customer return labels ship to Nalpac's returns warehouse.
# Customer pays for return shipping; cost is deducted from their refund.
NALPAC_WAREHOUSE_NAME=Nalpac
NALPAC_WAREHOUSE_STREET1=1365 Jarvis St
NALPAC_WAREHOUSE_STREET2=
NALPAC_WAREHOUSE_CITY=Ferndale
NALPAC_WAREHOUSE_STATE=MI
NALPAC_WAREHOUSE_ZIP=48220
NALPAC_WAREHOUSE_COUNTRY=US
NALPAC_WAREHOUSE_PHONE=
RETURN_WINDOW_DAYS=30

# EasyPost — return-label purchase (USPS Ground Advantage by default)
EASYPOST_API_KEY=                    # From easypost.com → API Keys. Use test key locally.

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
SANITY_PROJECT_ID=                   # From sanity.io/manage — create project first
SANITY_DATASET=production
SANITY_API_TOKEN=                    # Read+write token from sanity.io/manage > API > Tokens
SANITY_WEBHOOK_SECRET=               # Any random string — add to Sanity webhook header
SANITY_PREVIEW_SECRET=               # Any random string — used by /api/sanity-preview to enable draft mode
STUDIO_ALLOWED_ORIGINS=http://localhost:3333  # Comma-separated origins allowed CORS access (Sanity Studio)

# Phone/SMS draft-order caps (Phase L)
IVR_MAX_ORDER_VALUE_CENTS=50000      # $500 subtotal cap on phone/SMS-initiated draft orders
IVR_MAX_ITEMS_PER_ORDER=5
IVR_MAX_ORDERS_PER_24H=2             # per caller phone number

# ─── MCP server — SEO keyword bank agent ─────────────────────────────────────
# Bearer token for /mcp/seo-bank. Generate any random string (e.g.
# `openssl rand -hex 32`). Required to enable the endpoint — when unset, the
# route returns 503 (fail-closed). Set this in BOTH local .env and Vercel envs
# if you want to use the hosted agent.
MCP_BEARER_TOKEN=
# When the MCP server's `trigger_research` tool calls /cron/keyword-research,
# this is the base URL it hits. Defaults to http://localhost:$PORT (good for
# local dev). Set to https://xdipx.com to drive prod from anywhere.
MCP_CRON_BASE_URL=

# ─── DataForSEO — automated keyword research (optional) ───────────────────────
# Powers /cron/keyword-research. When unset, the cron falls back to LLM-only
# seed expansion (no real volume data, but the bank still grows).
# Sign up: https://app.dataforseo.com/register — pay-as-you-go, ~$20–40/mo.
#
# Two ways to authenticate — set EITHER, not both:
#   1. Login + API password (separate fields). API password is auto-generated
#      on the dashboard (NOT your login/dashboard password).
#   2. Pre-computed base64 string. The dashboard "API Access" page shows this
#      ready-to-paste — it's just base64("login:apipassword"). If set, this
#      takes precedence over the login/password pair.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_AUTH=
