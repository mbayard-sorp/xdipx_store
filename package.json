{
  "name": "xdipx-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm server/index.ts",
    "build": "react-router build && node scripts/build-vercel.mjs",
    "start": "cross-env NODE_ENV=production node --import tsx/esm server/index.ts",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "emma:log": "tsx scripts/inspect-emma-log.ts",
    "sanity:sync": "tsx scripts/sync-products-to-sanity.ts",
    "postinstall": "[ \"$VERCEL\" = \"1\" ] && npm run build || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^1.48.0",
    "@neondatabase/serverless": "^0.10.4",
    "@portabletext/react": "^6.0.3",
    "@portabletext/to-html": "^5.0.2",
    "@react-router/express": "^7.5.0",
    "@react-router/node": "^7.5.0",
    "@remotion/bundler": "^4.0.294",
    "@remotion/renderer": "^4.0.294",
    "@remotion/transitions": "^4.0.294",
    "@sanity/block-tools": "^3.70.0",
    "@sanity/client": "^7.20.0",
    "@sanity/visual-editing": "^5.3.3",
    "@sentry/node": "^10.48.0",
    "@sentry/react": "^10.48.0",
    "@types/compression": "^1.8.1",
    "@types/jsdom": "^28.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/kv": "^3.0.0",
    "botid": "^1.5.11",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.41.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "isbot": "^5.1.22",
    "jose": "^6.2.2",
    "jsdom": "^29.0.1",
    "motion": "^12.6.2",
    "oauth-1.0a": "^2.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "remotion": "^4.0.294",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.0",
    "@react-router/fs-routes": "^7.5.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
