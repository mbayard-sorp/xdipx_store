{
  "version": 2,
  "builds": [
    {
      "src": "server/vercel-entry.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["build/**", "node_modules/@react-router/**", "node_modules/react-router/**", "node_modules/react-router-dom/**"],
        "maxDuration": 300,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/vercel-entry.mjs"
    }
  ],
  "crons": [
    { "path": "/cron/daily-feed-processor", "schedule": "45 23 * * *" },
    { "path": "/cron/deal-activator",       "schedule": "59 23 * * *" },
    { "path": "/cron/profit-summary",       "schedule": "5 0 * * *"  },
    { "path": "/cron/review-reminders",     "schedule": "0 9 * * *"  },
    { "path": "/cron/inventory-check",      "schedule": "*/15 * * * *" },
    { "path": "/cron/keyword-research",     "schedule": "0 2 * * 0"  },
    { "path": "/cron/log-monitor",          "schedule": "*/15 * * * *" },
    { "path": "/cron/pricing-batch-recompute", "schedule": "0 7 * * *"  },
    { "path": "/cron/import-monitor",          "schedule": "0 8 * * *"  },
    { "path": "/cron/import-enrich",           "schedule": "*/30 * * * *" },
    { "path": "/cron/enrichment-batch-poller", "schedule": "*/2 * * * *"  },
    { "path": "/cron/aeo-surface-check",       "schedule": "0 6 * * 0"   }
  ]
}
