# Fly.io IVR service — set via `fly secrets set ...`

# ─── Port (Fly injects PORT automatically) ───────────────────────────────────
PORT=8080

# ─── Anthropic (Phase B) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Twilio (for signature verification + outbound SMS tool) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Shopify Admin (Phase D — order lookup) ──────────────────────────────────
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ─── Neon (Phase E — voicemail storage) ──────────────────────────────────────
DATABASE_URL=

# ─── Vercel internal-API bridge ──────────────────────────────────────────────
XDIPX_APP_URL=https://xdipx.com
INTERNAL_API_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Idle / cost limits (Phase G) ────────────────────────────────────────────
# All optional. Resolution order per call: admin values forwarded as WS URL
# params by the Vercel voice webhook (edit on /admin/voice-and-sms) win, then
# these env vars, then the defaults in src/config.ts. The values below MATCH
# src/config.ts — if you change a default, change it in both places.
IVR_INITIAL_SILENCE_MS=25000
IVR_INTER_TURN_SILENCE_MS=20000
IVR_MAX_CALL_DURATION_MS=900000
IVR_MAX_PROMPTS=60
IVR_RE_ENGAGE_ATTEMPTS=2
